# ==============================================================================
# CoupleRH - Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# Copie para .env.local para desenvolvimento ou configure na Vercel para deploy
# ==============================================================================

# URL do Projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública do Supabase (NUNCA coloque service_role no frontend!)
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui

# Ambiente Operacional do eSocial ('producao' ou 'restrita')
VITE_ESOCIAL_ENVIRONMENT=restrita

# Versão da Aplicação
VITE_APP_VERSION=1.0.0
